# ============================================================
# Translate provider config
# Copy file này thành .env rồi điền giá trị thật.
# Đổi TRANSLATE_PROVIDER là chuyển provider, không cần sửa code.
# ============================================================

# Chọn 1 trong: ollama | gemini | groq
TRANSLATE_PROVIDER=gemini

# (Optional) override model — bỏ trống để dùng default của provider
# Ollama default: qwen2.5:14b
# Gemini default: gemini-2.5-flash   (gemini-2.0-flash cũng OK)
# Groq   default: llama-3.3-70b-versatile
# TRANSLATE_MODEL=

# ---- Khi dùng Ollama (local, free vô hạn) ----
# Mặc định http://localhost:11434/v1, sửa nếu Ollama chạy ở host khác
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Khi dùng Gemini (Google AI Studio) ----
# Lấy key tại: https://aistudio.google.com/apikey
# Free tier: ~250 request/ngày, ~10 RPM
# GEMINI_API_KEY=AIza...

# ---- Khi dùng Groq Cloud ----
# Lấy key tại: https://console.groq.com/keys
# Free tier: 14 400 token/phút
# GROQ_API_KEY=gsk_...
