  {
    "start": 9.0,
    "end": 10.200000000000001,
    "text": "Còn mùi hôi khó chịu",
    "original_text": "还有一股怪味。"
  },
  {
    "start": 10.200000000000001,
    "end": 11.5,
    "text": "Đặt nó vào trong",
    "original_text": "你把它放进去,"
  },
  {
    "start": 11.5,
    "end": 12.8,
    "text": "Ngâm khoảng mười phút",
    "original_text": "浸泡十来分钟,"
  },
  {
    "start": 12.8,
    "end": 15.0,
    "text": "Sau đó nhẹ nhàng xoa xát",
    "original_text": "然后再轻轻揉一揉搓一搓,"
  },
  {
    "start": 15.0,
    "end": 17.05263157894737,
    "text": "Sau khi rửa xong như mới,",
    "original_text": "藏妈布这样洗完跟新的一样,"
  },
  {
    "start": 17.05263157894737,
    "end": 18.0,
    "text": "không còn vết bẩn nào.",
    "original_text": "还没有意味。"
