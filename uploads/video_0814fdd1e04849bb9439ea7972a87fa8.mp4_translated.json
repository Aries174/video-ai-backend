[
  {
    "start": 0.0,
    "end": 1.8526315789473686,
    "text": "Đừng đổ gạo của Tào Vận Thủy đi",
    "original_text": "淘宛水的米千万别倒了,"
  },
  {
    "start": 1.8526315789473686,
    "end": 3.2,
    "text": "Chắc còn dùng được lâu dài",
    "original_text": "怕可还有大用主。"
  },
  {
    "start": 3.2,
    "end": 4.1230769230769235,
    "text": "Dùng giấm trắng",
    "original_text": "倒上白醋,"
  },
  {
    "start": 4.1230769230769235,
    "end": 5.6000000000000005,
    "text": "Cộng thêm một muỗng baking soda",
    "original_text": "再来一勺小苏打。"
  },
  {
    "start": 5.6000000000000005,
    "end": 7.389473684210526,
    "text": "Nồi mẹ mua đã lâu",
    "original_text": "家里妈布用时间长了,"
  },
  {
    "start": 7.389473684210526,
    "end": 9.0,
    "text": "Dầu mỡ bám chặt khó rửa sạch",
    "original_text": "油油逆逆洗不干净,"
