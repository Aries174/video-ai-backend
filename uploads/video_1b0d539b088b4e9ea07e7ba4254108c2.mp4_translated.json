[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "Nước vo gạo đừng vội đổ đi.",
    "original_text": "淘宛水的米千万别倒了。"
  },
  {
    "start": 2.0,
    "end": 3.2,
    "text": "Nó còn rất nhiều công dụng.",
    "original_text": "Pak还有大用主。"
  },
  {
    "start": 3.2,
    "end": 4.161538461538462,
    "text": "Cho thêm một ít giấm trắng.",
    "original_text": "倒上白醋,"
  },
  {
    "start": 4.161538461538462,
    "end": 5.7,
    "text": "Tiếp theo cho một muỗng baking soda.",
    "original_text": "再来一勺小苏打。"
  },
  {
    "start": 5.7,
    "end": 7.436842105263158,
    "text": "Khăn lau trong nhà dùng lâu ngày.",
    "original_text": "家里妈布用时间长了,"
  },
  {
    "start": 7.436842105263158,
    "end": 9.0,
    "text": "Bám đầy dầu mỡ, rất khó giặt sạch.",
    "original_text": "油油逆逆洗不干净。"
  },
  {
    "start": 9.0,
    "end": 10.3,
    "text": "Lại còn có mùi khó chịu.",
    "original_text": "还有一股怪味。"
  },
  {
    "start": 10.3,
    "end": 11.55,
    "text": "Hãy cho chiếc khăn vào dung dịch đó.",
    "original_text": "你把它放进去,"
  },
  {
    "start": 11.55,
    "end": 12.8,
    "text": "Ngâm khoảng mười phút.",
    "original_text": "浸泡十来分钟,"
  },
  {
    "start": 12.8,
    "end": 14.323076923076924,
    "text": "Sau đó vò và chà nhẹ vài lần.",
    "original_text": "然后再轻轻揉一揉,"
  },
  {
    "start": 14.323076923076924,
    "end": 15.0,
    "text": "cà lại một chút.",
    "original_text": "搓一搓。"
  },
  {
    "start": 15.0,
    "end": 17.05263157894737,
    "text": "Khăn lau sạch như mới.",
    "original_text": "藏妈布这样洗完跟新的一样,"
  },
  {
    "start": 17.05263157894737,
    "end": 18.0,
    "text": "không còn mùi hôi.",
    "original_text": "还没有意味。"
  }
